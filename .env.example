APP_ENV=development
APP_PORT=__API_PORT__

DB_HOST=__DB_HOST__
DB_PORT=__DB_PORT__
DB_NAME=__DB_NAME__
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_LIFETIME_MINUTES=5

JWT_SECRET=__JWT_SECRET__
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

ENABLE_REDIS=__ENABLE_REDIS__
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAME_SITE=Lax

CORS_ORIGINS=http://localhost:3000

DEFAULT_LOCALE=th
